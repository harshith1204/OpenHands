# Copy to .env and adjust for local Simpo UI Builder pilot.
#
# xAI (configure API key in OpenHands Settings UI):
#   Provider: xai
#   Model: grok-4.3
#   reasoning_effort: low (none | low | medium | high)
#   Do not use legacy Grok models (grok-3, grok-4*, grok-code-fast*, etc.)
#
# Simpo xAI-only LLM discovery (unset to restore full provider catalogue):
OH_DEFAULT_LLM_MODEL=xai/grok-4.3
OH_DEFAULT_LLM_REASONING_EFFORT=low
OH_LLM_PROVIDER_ALLOWLIST=xai
#
# Mount both UI repo and simpo-ui-kit for the agent workspace:
WORKSPACE_BASE=/Users/harshith
#
# UI repo: /Users/harshith/UI
# See UI/README.md for simpo-ui-kit pack/install and pilot prompt.
