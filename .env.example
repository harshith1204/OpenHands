# xAI LLM defaults:
#   Provider: xai
#   Model: grok-4.3
#   reasoning_effort: low (none | low | medium | high)
#   xAI docs use the OpenAI-compatible base URL below.
OH_DEFAULT_LLM_MODEL=xai/grok-4.3
OH_DEFAULT_LLM_REASONING_EFFORT=low
OH_DEFAULT_LLM_API_KEY=xai-your-key
OH_DEFAULT_LLM_BASE_URL=https://api.x.ai/v1
HIDE_LLM_SETTINGS=true
OH_ALLOW_USER_LLM_CONFIGURATION=false
#
# Agent workspace root (optional):
WORKSPACE_BASE=/Users/harshith
